# Daily brief — per-person configuration.
# Copy to ~/daily-brief/config.env and fill in. Sourced by bash, so $HOME works
# and values with spaces need quotes. Every list is space-separated.
#
# Everything the brief knows about *you* lives here. collect.sh reads this file
# and embeds it in the day's data JSON, so the prompt and the runner never carry
# an identity of their own — editing this file is enough to retarget the brief.

# ---- who you are -------------------------------------------------------------

# First name / short name. Used throughout the brief's prose.
BRIEF_DISPLAY_NAME="Ada"

# Every git email you commit under. Multiple entries are OR'd, which matters if
# you have both a contractor and a company address in your history. Check with:
#   git -C <repo> log -500 --format='%ae' | sort | uniq -c | sort -rn
# Miss one and every commit under it vanishes from *Shipped* silently.
#
# CAUTION on machine-local identities. `git config user.email` may be something
# like tooling-setup@local, set by an installer rather than by you. On your own
# machine those commits are yours and belong here — but the same address is NOT
# unique to you, so if a teammate pushes under it too, listing it here attributes
# their commits to you. Prefer a real address, and add a local one only after
# confirming the commits it matches in your repos are actually yours.
BRIEF_GIT_AUTHORS="ada@example.com ada.lovelace@company.com"

# Signature on the brief's last line: "— generated by <this> · <timestamp>".
BRIEF_WATERMARK="Claude"

# ---- DELIVERY ----------------------------------------------------------------
# Where the brief goes. Space-separated list; all listed channels get the same
# brief. Supported: gchat, slack, email.
#   gchat  — Google Chat space, via a Chat MCP server
#   slack  — Slack channel, via a connected Slack integration
#   email  — HTML mail, via a Gmail MCP server
# Each channel's rules live in the skill's delivery/<channel>.md.
BRIEF_DELIVERY="gchat"

# -- gchat --
# Bare space id, no "spaces/" prefix. Find it with chat_list_spaces.
BRIEF_GCHAT_SPACE_ID=""
# Your Chat user id, "users/<numeric>" — used to detect @-mentions of you.
# Find it with chat_list_messages on a space you have posted in.
BRIEF_GCHAT_USER_ID=""

# -- slack --
# Channel id (C…) or #name. Passed through as written.
BRIEF_SLACK_CHANNEL=""
# Your Slack member id (U…), only needed if the brief should @-mention you.
BRIEF_SLACK_USER_ID=""

# -- email --
# Recipients. "me" means the authenticated mailbox. Sending to anyone else makes
# the brief outward-facing — see delivery/email.md before you do.
BRIEF_EMAIL_TO="me"
# Subject becomes "<prefix> — <Weekday>, <Mon DD>". The duplicate check greps it,
# so changing it mid-week can allow one duplicate send.
BRIEF_EMAIL_SUBJECT_PREFIX="Daily Brief"

# ---- SOURCES -----------------------------------------------------------------
# Which inbound scans to run. Switch off what you do not use — a Slack shop with
# no Google Chat should not pay for a Chat scan that finds nothing.
# NOTE: Slack is a delivery target only; scanning Slack for your mentions is not
# implemented.
BRIEF_SOURCE_GITHUB=true
BRIEF_SOURCE_JIRA=true
BRIEF_SOURCE_GCHAT=true
BRIEF_SOURCE_GMAIL=true
BRIEF_SOURCE_CALENDAR=true

# ---- local repos -------------------------------------------------------------
# The local half of the brief. Leave BRIEF_REPO_ROOT empty if this machine has no
# clones — the brief then runs cloud-only and says so, rather than implying a
# quiet day.

# Parent directory holding your clones.
BRIEF_REPO_ROOT="$HOME/dev"

# Clone directory names under BRIEF_REPO_ROOT. Missing ones are skipped silently.
BRIEF_REPOS="my-app my-service"

# Where the agent CLI keeps session transcripts, mined for what you worked on.
# Absent directory → the sessions list is simply empty.
BRIEF_SESSION_DIR="$HOME/.claude/projects"

# ---- GitHub ------------------------------------------------------------------

# Your GitHub login. Given to the model as fact so it never spends a turn on
# github_get_viewer.
BRIEF_GITHUB_LOGIN="ada-example"

# owner/name repos to search for your PRs, reviews, and mentions.
BRIEF_GITHUB_REPOS="acme/my-app acme/my-service"

# ---- Jira --------------------------------------------------------------------

# Project key. Only shapes ticket examples in the brief; Jira queries run against
# currentUser().
BRIEF_JIRA_PROJECT="PROJ"

# ---- Gmail (as a source) -----------------------------------------------------

# Senders to exclude from the mail scan. Notification robots belong here: their
# content reaches the brief from its source of truth (GitHub/Jira) instead, so
# leaving them in only produces duplicate, lower-quality lines.
BRIEF_GMAIL_EXCLUDE="-from:notifications@github.com -from:noreply@github.com"

# ---- scheduling (opt-in; macOS + a local agent CLI only) ---------------------

# Local time the launchd job fires, Mon–Fri. Only used by `install.sh --schedule`.
BRIEF_SCHEDULE_HOUR="7"
BRIEF_SCHEDULE_MINUTE="45"

# ---- headless runner knobs ---------------------------------------------------
# Only used by run.sh (the terminal/cron path). Ignored in an agent session.

# Repo whose .mcp.json is the source of truth for MCP config and any bridge token.
# The runner re-derives its own mcp.json from it on every run, so a token you
# refreshed in a normal session is picked up without touching anything here.
# Leave empty if your agent CLI needs no --mcp-config.
BRIEF_MCP_SOURCE_DIR=""

# MCP servers the brief needs — a trimmed subset of the source config. Adding
# servers you do not print from costs tokens for nothing.
BRIEF_SERVERS="atlassian calendar chat github gmail"

# Attempt ladder as "model:backoff_seconds_before_this_attempt". Falls across
# models so one capacity-blocked tier does not lose the day's brief.
BRIEF_MODELS="sonnet:0 sonnet:45 opus:60 haiku:60"

# Page to renew an expired MCP bridge token, quoted back to you in the "brief
# blocked" alert. Leave empty if your setup has no such flow.
BRIEF_REFRESH_URL=""
